{
  "name": "hub-run",
  "version": "0.1.0",
  "description": "Shared web shell for Codex and Claude conversation access",
  "type": "module",
  "bin": {
    "hub-run": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:server\"",
    "dev:server": "tsx watch api/index.ts --dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsup api/index.ts --format esm --dts --clean",
    "build:web": "vite build --config web/vite.config.ts",
    "runtime:install": "tsx scripts/runtime-manager.ts install",
    "runtime:start": "tsx scripts/runtime-manager.ts start",
    "runtime:restart": "tsx scripts/runtime-manager.ts restart",
    "runtime:stop": "tsx scripts/runtime-manager.ts stop",
    "runtime:status": "tsx scripts/runtime-manager.ts status",
    "runtime:uninstall": "tsx scripts/runtime-manager.ts uninstall",
    "runtime:reload": "pnpm build && pnpm runtime:restart",
    "start": "node dist/index.js",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "commander": "^13.1.0",
    "hono": "^4.7.8",
    "lucide-react": "^0.562.0",
    "open": "^10.1.0",
    "opusscript": "^0.1.1",
    "protobufjs": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.7",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.7",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
